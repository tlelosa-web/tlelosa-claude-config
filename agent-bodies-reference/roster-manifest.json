{
  "$comment": "Single source of truth for what the DCOE roster IS. Consumed by bootstrap.mjs. Keep in step with CORE.md's roster and model-routing tables — spec: docs/specs/2026-08-09-universal-roster-and-codex-gate.md (in the Claude-Code hub).",
  "manifestVersion": 1,
  "coreVersion": "1.10",
  "agents": [
    { "file": "domain.md",     "model": "claude-sonnet-5",  "effort": "medium", "role": "Session start, scope confirmation" },
    { "file": "planner.md",    "model": "claude-sonnet-5",  "effort": "medium", "role": "Break features into spec + tasks" },
    { "file": "architect.md",  "model": "claude-opus-5",    "effort": "high",   "role": "System design, ADRs, DB schema", "standingPin": true },
    { "file": "executor.md",   "model": "claude-sonnet-5",  "effort": "medium", "role": "Implement a single well-defined task" },
    { "file": "tester.md",     "model": "claude-sonnet-5",  "effort": "medium", "role": "Write tests, TDD loops" },
    { "file": "reviewer.md",   "model": "claude-opus-5",    "effort": "high",   "role": "Code review, security, quality gate", "standingPin": true },
    { "file": "doc-writer.md", "model": "claude-sonnet-5",  "effort": "medium", "role": "Update docs, README, changelogs" },
    { "file": "debugger.md",   "model": "claude-sonnet-5",  "effort": "medium", "role": "Systematic bug investigation" },
    { "file": "data-agent.md", "model": "claude-sonnet-5",  "effort": "medium", "role": "Excel/CSV transforms, report processing" },
    { "file": "explore.md",    "model": "claude-haiku-4-5", "effort": "low",    "role": "Read-only search/grep tier" }
  ],
  "requiredPlugins": [
    "dcoe-roster@tlelosa-claude-config",
    "codex-gate@tlelosa-claude-config"
  ]
}
